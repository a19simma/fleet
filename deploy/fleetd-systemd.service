[Unit]
Description=Fleet per-box daemon (systemd agent launcher)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=fleetd
Group=fleetd
SupplementaryGroups=fleet-work
EnvironmentFile=-/etc/swarm/box.env
EnvironmentFile=-/etc/swarm/secrets.env
ExecStart=/usr/local/bin/fleetd serve
Restart=always
RestartSec=2
WatchdogSec=60
TimeoutStopSec=15
StateDirectory=fleetd
StateDirectoryMode=0700
RuntimeDirectory=fleetd
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/fleet/jobs /run/fleet
UMask=0077
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
